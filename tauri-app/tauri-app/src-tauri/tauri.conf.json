  {
    "build": {
      "beforeBuildCommand": "npm run build", 
      "beforeDevCommand": "npm run dev",
      "devPath": "http://localhost:5173",
      "distDir": "../dist"
    },
    "package": {
      "productName": "Space Astrophysics Desktop",
      "version": "0.1.0"
    },
    "tauri": {
      "allowlist": {
        "all": true
      },
      "bundle": {
        "active": true,
        "identifier": "com.space.astrophysics.desktop",
        "targets": "all",
        "icon": [
          "icons/32x32.png",
          "icons/128x128.png",
          "icons/128x128@2x.png",
          "icons/icon.icns",
          "icons/icon.ico"
        ]
      },
      "security": {
        "csp": "default-src 'self' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:9000"
      },
      "windows": [
        {
          "height": 700,
          "resizable": true, 
          "title": "Space Astrophysics Desktop",
          "width": 1000,
          "fullscreen": false
        }
      ]
    }
  }